# ============================================
# FinResolve AI — .gitignore
# ============================================

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
eggs/
*.whl
pip-log.txt
pip-delete-this-directory.txt

# Virtual environments
.venv/
venv/
ENV/
env/

# Pytest / Coverage
.pytest_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover

# Mypy
.mypy_cache/

# Ruff
.ruff_cache/

# ---- Node.js / Next.js ----
node_modules/
.next/
out/
.turbo/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- Environment ----
.env
.env.local
.env.*.local

# ---- Docker ----
docker-compose.override.yml

# ---- IDE ----
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ---- Data artifacts (generated) ----
data/generated/
data/outputs/
*.parquet
*.csv
!data/fixtures/*.csv

# ---- ML artifacts ----
ml/models/checkpoints/
ml/models/saved/
*.joblib
*.pkl
*.h5
wandb/
mlruns/

# ---- Logs ----
logs/
*.log

# ---- Secrets ----
*.pem
*.key
