# ============================================
# FinResolve AI — Environment Configuration
# ============================================
# Copy this file to .env and fill in values.
# NEVER commit .env to version control.
# ============================================

# ---- Application ----
APP_NAME=finresolve-ai
APP_ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=INFO
DEBUG=true

# ---- API Server ----
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
CORS_ORIGINS=http://localhost:3000

# ---- Database (PostgreSQL) ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=finresolve
POSTGRES_USER=finresolve
POSTGRES_PASSWORD=CHANGE_ME_IN_PRODUCTION

# Constructed connection string (used by the app):
# DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
DATABASE_URL=postgresql://finresolve:CHANGE_ME_IN_PRODUCTION@localhost:5432/finresolve

# ---- Policy Engine Thresholds ----
# Minimum confidence score (0.0–1.0) for autonomous resolution
POLICY_AUTO_RESOLVE_CONFIDENCE_THRESHOLD=0.95
# Maximum transaction value (in minor currency units, e.g. paise) for autonomous resolution
POLICY_AUTO_RESOLVE_MAX_AMOUNT=500000
# Whether autonomous resolution is enabled at all
POLICY_AUTO_RESOLVE_ENABLED=false

# ---- LLM (Future — Phase 3+) ----
# LLM_PROVIDER=openai
# LLM_API_KEY=
# LLM_MODEL=gpt-4o
# LLM_MAX_TOKENS=4096
# LLM_TEMPERATURE=0.1

