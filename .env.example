# ============================================
# FinResolve AI — Environment Configuration Example
# ============================================
# Copy this file to .env and fill in values for local development.
# NEVER commit .env to version control.
# ============================================

# ---- Application ----
APP_NAME=finresolve-ai
APP_ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=INFO
DEBUG=false

# ---- API Server & Security ----
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
CORS_ORIGINS=http://localhost:3000
TRUSTED_HOSTS=localhost,127.0.0.1
MAX_REQUEST_SIZE_BYTES=10485760

# ---- Authentication & Authorization ----
AUTH_ENABLED=false
AUTH_SECRET_KEY=dev-secret-key-change-in-production-only-min-32-chars
AUTH_TOKEN_EXPIRE_MINUTES=60

# ---- Rate Limiting ----
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=120
RATE_LIMIT_BURST=30

# ---- Database (PostgreSQL) ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=finresolve
POSTGRES_USER=finresolve
POSTGRES_PASSWORD=CHANGE_ME_IN_PRODUCTION
DATABASE_URL=postgresql://finresolve:CHANGE_ME_IN_PRODUCTION@localhost:5432/finresolve

# ---- Policy Engine Thresholds (Simulation Only) ----
POLICY_AUTO_RESOLVE_CONFIDENCE_THRESHOLD=0.95
POLICY_AUTO_RESOLVE_MAX_AMOUNT=500000
POLICY_AUTO_RESOLVE_ENABLED=false
